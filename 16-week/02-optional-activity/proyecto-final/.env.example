# Plantilla de variables de entorno. Copia este archivo como .env y cambia los valores.
# El .env real no se sube a GitHub (esta en .gitignore).

# Clave para firmar los tokens JWT (minimo 32 caracteres). Pon una propia y larga
JWT_SECRET=cambia-esta-clave-por-una-propia-de-32-o-mas-caracteres

# Direccion del frontend (origen permitido en CORS)
#   en mi equipo: http://localhost:5173
#   en AWS EC2:   http://<IP-publica-de-la-EC2>:5173
CORS_ORIGIN=http://localhost:5173

# Direccion de la API que usa el frontend desde el navegador
#   en mi equipo: http://localhost:8080/api
#   en AWS EC2:   http://<IP-publica-de-la-EC2>:8080/api
VITE_API_URL=http://localhost:8080/api
